#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

IDD_MAIN DIALOGEX 0, 0, 420, 350
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "SIMUL  ·  통신선 루프백 시험기"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "접속 설정",                                 -1, 10,   8, 400,  86

    LTEXT           "접속 방식",                                 -1, 22,  24,  50,  10
    COMBOBOX        IDC_TRANSPORT_COMBO,                             78,  22, 150,  80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_TABSTOP | WS_VSCROLL

    LTEXT           "직렬 포트",                                 -1, 22,  42,  50,  10
    EDITTEXT        IDC_SERIAL_PORT,                                 78,  40,  60,  13, ES_AUTOHSCROLL
    LTEXT           "통신 속도",                                 -1,146,  42,  36,  10
    EDITTEXT        IDC_SERIAL_BAUD,                                184,  40,  52,  13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "bps",                                       -1,240,  42,  16,  10
    PUSHBUTTON      "가상 포트 쌍 생성 (VSPE)", IDC_VSPE_BUTTON,    300,  39, 102,  15

    LTEXT           "TCP 상대",                                  -1, 22,  60,  50,  10
    EDITTEXT        IDC_TCP_HOST,                                    78,  58,  90,  13, ES_AUTOHSCROLL
    LTEXT           "포트",                                      -1,174,  60,  22,  10
    EDITTEXT        IDC_TCP_PORT,                                   200,  58,  44,  13, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "UDP 수신",                                  -1, 22,  78,  50,  10
    EDITTEXT        IDC_UDP_LOCAL_HOST,                              78,  76,  72,  13, ES_AUTOHSCROLL
    EDITTEXT        IDC_UDP_LOCAL_PORT,                             154,  76,  40,  13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "UDP 상대",                                  -1,208,  78,  48,  10
    EDITTEXT        IDC_UDP_REMOTE_HOST,                            260,  76,  72,  13, ES_AUTOHSCROLL
    EDITTEXT        IDC_UDP_REMOTE_PORT,                            336,  76,  40,  13, ES_AUTOHSCROLL | ES_NUMBER

    GROUPBOX        "시험 조건",                                 -1, 10, 100, 400,  34
    LTEXT           "시험 시간",                                 -1, 22, 116,  50,  10
    EDITTEXT        IDC_DURATION_HOURS,                              78, 114,  28,  13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "시간",                                      -1,110, 116,  18,  10
    EDITTEXT        IDC_DURATION_MINUTES,                           132, 114,  28,  13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "분  (최대 72시간)",                         -1,164, 116,  90,  10
    LTEXT           "송신 주기 50 ms · DATA 32 Byte",            -1,270, 116, 132,  10

    GROUPBOX        "판정",                                      -1, 10, 140, 400,  58
    CTEXT           "대 기",          IDC_RESULT_TEXT,              18, 154, 384,  38, SS_CENTERIMAGE

    LTEXT           "송신 0",         IDC_TX_COUNT,                 18, 206,  90,  12
    LTEXT           "수신 0",         IDC_RX_COUNT,                108, 206,  90,  12
    LTEXT           "실패 0",         IDC_FAIL_COUNT,              198, 206,  90,  12
    RTEXT           "경과 0:00:00 / 0:00:00", IDC_ELAPSED_TEXT,    282, 206, 120,  12

    LTEXT           "접속 방식 선택 후 시험 시작.", IDC_STATUS_TEXT, 18, 222, 384,  10

    DEFPUSHBUTTON   "시험 시작",      IDC_START_BUTTON,            110, 238,  90,  18
    PUSHBUTTON      "시험 정지",      IDC_STOP_BUTTON,             220, 238,  90,  18

    GROUPBOX        "시험 기록",                                 -1, 10, 262, 400,  82
    EDITTEXT        IDC_LOG_TEXT,                                    18, 274, 384,  65,
                    ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Jeongmin Lee"
            VALUE "FileDescription",  "SIMUL Loopback Verifier"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SIMUL"
            VALUE "LegalCopyright",   "Copyright (C) Jeongmin Lee"
            VALUE "OriginalFilename", "SIMUL.exe"
            VALUE "ProductName",      "SIMUL"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
