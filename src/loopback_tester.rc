#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

1 24 "loopback_tester.manifest"

IDD_MAIN DIALOGEX 0, 0, 706, 304
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Loopback Tester"
FONT 9, "Malgun Gothic", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_HEADER, "Static", SS_OWNERDRAW, 0, 0, 706, 26

    CONTROL         "", IDC_VERDICT, "Static", SS_OWNERDRAW, 12, 36, 400, 64

    LTEXT           "시험 조건", IDC_SECTION_TEST, 424, 36, 270, 10
    LTEXT           "채널 수", IDC_COUNT_LABEL, 424, 53, 42, 8
    EDITTEXT        IDC_CHANNEL_COUNT, 466, 50, 36, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_CHANNEL_COUNT_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    0, 0, 10, 14
    LTEXT           "회신 제한", IDC_ECHO_LABEL, 562, 53, 42, 8
    EDITTEXT        IDC_ECHO_TIMEOUT, 606, 50, 50, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ms", IDC_ECHO_UNIT, 660, 53, 20, 8
    LTEXT           "시험 시간", IDC_DURATION_LABEL, 424, 71, 42, 8
    EDITTEXT        IDC_DURATION_HOURS, 466, 68, 36, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_DURATION_HOURS_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    0, 0, 10, 14
    LTEXT           "시간", IDC_DURATION_HOURS_UNIT, 506, 71, 18, 8
    EDITTEXT        IDC_DURATION_MINUTES, 526, 68, 36, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_DURATION_MINUTES_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    0, 0, 10, 14
    LTEXT           "분 (최대 72시간)", IDC_DURATION_MINUTES_UNIT, 566, 71, 80, 8
    CONTROL         "시험 시작", IDC_START_BUTTON, "Button", BS_OWNERDRAW | WS_TABSTOP, 424, 86, 131, 18
    CONTROL         "시험 중지", IDC_STOP_BUTTON, "Button", BS_OWNERDRAW | WS_TABSTOP, 563, 86, 131, 18

    LTEXT           "채널 현황", IDC_SECTION_CHANNELS, 12, 110, 200, 10
    RTEXT           "", IDC_CHANNEL_SUMMARY, 212, 110, 200, 10
    CONTROL         "", IDC_CHANNEL_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
                    12, 122, 400, 114

    LTEXT           "채널 설정", IDC_SECTION_EDITOR, 424, 110, 270, 10
    LTEXT           "접속 방식", IDC_TRANSPORT_LABEL, 424, 127, 42, 8
    COMBOBOX        IDC_TRANSPORT_COMBO, 466, 124, 88, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "인터페이스", IDC_SERIAL_STANDARD_LABEL, 562, 127, 42, 8
    COMBOBOX        IDC_SERIAL_STANDARD, 606, 124, 88, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "포트", IDC_SERIAL_PORT_LABEL, 424, 145, 42, 8
    COMBOBOX        IDC_SERIAL_PORT, 466, 142, 64, 160, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "갱신", IDC_SERIAL_REFRESH, "Button", BS_OWNERDRAW | WS_TABSTOP, 533, 142, 21, 14
    LTEXT           "통신 속도", IDC_SERIAL_BAUD_LABEL, 562, 145, 42, 8
    COMBOBOX        IDC_SERIAL_BAUD, 606, 142, 62, 160, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "bps", IDC_SERIAL_BAUD_UNIT, 672, 145, 22, 8
    LTEXT           "데이터 비트", IDC_SERIAL_DATA_LABEL, 424, 163, 42, 8
    COMBOBOX        IDC_SERIAL_DATA, 466, 160, 88, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "패리티", IDC_SERIAL_PARITY_LABEL, 562, 163, 42, 8
    COMBOBOX        IDC_SERIAL_PARITY, 606, 160, 88, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "정지 비트", IDC_SERIAL_STOP_LABEL, 424, 181, 42, 8
    COMBOBOX        IDC_SERIAL_STOP, 466, 178, 88, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "흐름 제어", IDC_SERIAL_FLOW_LABEL, 562, 181, 42, 8
    COMBOBOX        IDC_SERIAL_FLOW, 606, 178, 88, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "송신 반향", IDC_SERIAL_ECHO_LABEL, 424, 199, 42, 8
    COMBOBOX        IDC_SERIAL_ECHO, 466, 196, 88, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "RS-485 2선식 어댑터의 자기 송신 수신 여부", IDC_SERIAL_ECHO_HINT, 562, 199, 132, 8

    LTEXT           "상대 주소", IDC_TCP_HOST_LABEL, 424, 145, 42, 8
    EDITTEXT        IDC_TCP_HOST, 466, 142, 88, 14, ES_AUTOHSCROLL
    LTEXT           "상대 포트", IDC_TCP_PORT_LABEL, 562, 145, 42, 8
    EDITTEXT        IDC_TCP_PORT, 606, 142, 50, 14, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "수신 주소", IDC_UDP_LOCAL_LABEL, 424, 145, 42, 8
    EDITTEXT        IDC_UDP_LOCAL_HOST, 466, 142, 88, 14, ES_AUTOHSCROLL
    LTEXT           "수신 포트", IDC_UDP_LOCAL_PORT_LABEL, 562, 145, 42, 8
    EDITTEXT        IDC_UDP_LOCAL_PORT, 606, 142, 50, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "상대 주소", IDC_UDP_REMOTE_LABEL, 424, 163, 42, 8
    EDITTEXT        IDC_UDP_REMOTE_HOST, 466, 160, 88, 14, ES_AUTOHSCROLL
    LTEXT           "상대 포트", IDC_UDP_REMOTE_PORT_LABEL, 562, 163, 42, 8
    EDITTEXT        IDC_UDP_REMOTE_PORT, 606, 160, 50, 14, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "", IDC_CHANNEL_DETAIL, 424, 214, 270, 22, SS_NOPREFIX

    LTEXT           "시험 기록", IDC_SECTION_LOG, 12, 244, 682, 10
    EDITTEXT        IDC_LOG_TEXT, 12, 256, 682, 40, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "FileDescription",  "Loopback Tester"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "LoopbackTester"
            VALUE "OriginalFilename", "LoopbackTester.exe"
            VALUE "ProductName",      "Loopback Tester"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END
